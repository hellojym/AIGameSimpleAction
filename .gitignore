# ============================================================
# Unity / 团结引擎（Tuanjie）工程标准忽略规则
# ============================================================

# 引擎自动生成的缓存与产物（体积大、可完全再生、且含本机绝对路径）
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Aa]ssets/[Aa]ssetStoreTools*
/[Aa]ssets/[Pp]lugins/[Ee]ditor/JetBrains*

# 引擎崩溃 / 导入日志
sysinfo.txt
*.stackdump
crashlytics-build.properties

# ============================================================
# WorkBuddy 工程数据（记录含 /Users/<本机用户名>/ 绝对路径，不入库）
# ============================================================
/.workbuddy/

